# Copy to backend/.env and replace every placeholder with a real value.
# backend/.env is gitignored — never commit real credentials.

PORT=5000
MONGO_URI=mongodb://localhost:27017/school-enquiries
# At least 32 random characters; the server refuses to start with this placeholder.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call this API from a browser.
# Defaults to the Vite dev server; set it to the public site's URL to deploy.
CORS_ORIGIN=http://localhost:5177

# Number of reverse proxies in front of this app, so the rate limiters see the
# caller's real address. Leave unset when running the server directly.
# TRUST_PROXY=1

# Name used in the from-address and signature of every email sent to parents.
SCHOOL_NAME=Mandela Bilingual Nursery and Primary School

# SMTP transport for reply and notification email. Production uses Brevo on
# port 2525, because Render's free tier blocks 25/465/587 (see DEPLOYMENT.md).
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
# Brevo's SMTP login (xxxx@smtp-brevo.com) and SMTP key — not your account password.
EMAIL_USER=your-login@smtp-brevo.com
EMAIL_PASS=your-brevo-smtp-key
# Address parents see mail from; must be a sender verified in Brevo.
# Leave unset with mailbox-style SMTP (e.g. Gmail), where EMAIL_USER is used.
EMAIL_FROM=admissions@example.com

# Inbox that receives a notification whenever a new enquiry arrives
ADMIN_EMAIL=admissions@example.com

# Used only by `npm run seed:admin` to create the first dashboard login.
# Change the password after the first sign-in.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-this-password
ADMIN_SEED_ROLE=admin
